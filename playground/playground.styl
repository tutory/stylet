@import '../site/theme'
@import '../site/highlight'

html,
body {
  height: 100%
  margin: 0
}

body {
  background: var(--bg)
  color: var(--text)
  display: flex
  flex-direction: column
  font: 14px/1.5 system-ui, -apple-system, "Segoe UI", sans-serif
}

header {
  align-items: center
  border-bottom: 1px solid var(--border)
  display: flex
  flex-wrap: wrap
  gap: .5rem 1rem
  padding: .75rem 1rem
}

h1 {
  font-size: 1.1rem
  margin: 0 auto 0 0
}

h1 a {
  color: inherit
  text-decoration: none
}

h1 span {
  color: var(--muted)
  font-size: .8rem
  font-weight: normal
}

h2 {
  color: var(--muted)
  font-size: .75rem
  letter-spacing: .05em
  margin: 0
  padding: .5rem 1rem
  text-transform: uppercase
}

label {
  align-items: center
  display: inline-flex
  flex: none
  gap: .3rem
  white-space: nowrap
}

button {
  @extend $panel
  border-radius: 6px
  color: var(--text)
  cursor: pointer
  font: inherit
  padding: .25rem .75rem

  &:hover {
    border-color: var(--accent)
  }
}

a {
  color: var(--accent)
}

main {
  display: grid
  flex: 1
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr)
  min-height: 0
}

.pane {
  display: flex
  flex-direction: column
  min-height: 0
  min-width: 0

  & + & {
    border-left: 1px solid var(--border)
  }
}

.editor {
  flex: 1
  min-height: 0
  position: relative

  textarea,
  pre {
    inset: 0
    position: absolute
  }

  pre {
    overflow: hidden
    pointer-events: none
  }
}

/* Once highlighting works, the textarea only shows the caret and selection. */
.highlighted .editor textarea {
  background: transparent
  color: transparent
  caret-color: var(--text)
}

.editor pre {
  visibility: hidden
}

.highlighted .editor pre {
  visibility: visible
}

textarea,
pre {
  background: var(--panel)
  border: 0
  color: var(--text)
  flex: 1
  font: 13px/1.55 var(--mono)
  margin: 0
  outline: none
  overflow: auto
  padding: .75rem 1rem
  resize: none
  tab-size: 2
  white-space: pre
}

#diagnostics {
  border-top: 1px solid var(--border)
  font: 12px/1.5 var(--mono)
  list-style: none
  margin: 0
  max-height: 30%
  overflow: auto
  padding: 0

  &:empty {
    display: none
  }

  li {
    cursor: pointer
    overflow-wrap: anywhere
    padding: .3rem 1rem

    &:hover {
      background: var(--bg)
    }
  }

  .error {
    color: var(--error)
  }

  .warning {
    color: var(--warning)
  }
}

@media (--narrow) {
  h1 {
    flex-basis: 100%
  }

  main {
    grid-template-columns: minmax(0, 1fr)
    grid-template-rows: minmax(0, 1fr) minmax(0, 1fr)
  }

  .pane + .pane {
    border-left: 0
    border-top: 1px solid var(--border)
  }
}
