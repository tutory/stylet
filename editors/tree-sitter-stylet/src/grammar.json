{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "stylet",
  "rules": {
    "stylesheet": {
      "type": "REPEAT",
      "content": {
        "type": "SYMBOL",
        "name": "_statement"
      }
    },
    "_statement": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "import_statement"
        },
        {
          "type": "SYMBOL",
          "name": "extend_statement"
        },
        {
          "type": "SYMBOL",
          "name": "at_rule"
        },
        {
          "type": "SYMBOL",
          "name": "placeholder_rule"
        },
        {
          "type": "SYMBOL",
          "name": "rule_set"
        },
        {
          "type": "SYMBOL",
          "name": "declaration"
        }
      ]
    },
    "comment": {
      "type": "TOKEN",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": "//"
              },
              {
                "type": "PATTERN",
                "value": "[^\\n]*"
              }
            ]
          },
          {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": "/*"
              },
              {
                "type": "PATTERN",
                "value": "[^*]*\\*+([^/*][^*]*\\*+)*"
              },
              {
                "type": "STRING",
                "value": "/"
              }
            ]
          }
        ]
      }
    },
    "import_statement": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "@import"
        },
        {
          "type": "SYMBOL",
          "name": "_values"
        },
        {
          "type": "SYMBOL",
          "name": "_terminator"
        }
      ]
    },
    "extend_statement": {
      "type": "SEQ",
      "members": [
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "STRING",
              "value": "@extend"
            },
            {
              "type": "STRING",
              "value": "@extends"
            }
          ]
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "SYMBOL",
              "name": "placeholder_name"
            },
            {
              "type": "REPEAT",
              "content": {
                "type": "SEQ",
                "members": [
                  {
                    "type": "STRING",
                    "value": ","
                  },
                  {
                    "type": "SYMBOL",
                    "name": "placeholder_name"
                  }
                ]
              }
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "_terminator"
        }
      ]
    },
    "at_rule": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "at_keyword"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "prelude"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "block"
            },
            {
              "type": "SYMBOL",
              "name": "_terminator"
            }
          ]
        }
      ]
    },
    "at_keyword": {
      "type": "PATTERN",
      "value": "@[a-zA-Z-][\\w-]*"
    },
    "prelude": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_prelude_item"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "_prelude_item"
              },
              {
                "type": "SEQ",
                "members": [
                  {
                    "type": "STRING",
                    "value": ","
                  },
                  {
                    "type": "SYMBOL",
                    "name": "_prelude_item"
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    "_prelude_item": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_value"
        },
        {
          "type": "STRING",
          "value": ":"
        }
      ]
    },
    "placeholder_rule": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "placeholder_name"
        },
        {
          "type": "SYMBOL",
          "name": "block"
        }
      ]
    },
    "placeholder_name": {
      "type": "PATTERN",
      "value": "\\$[a-zA-Z_-][\\w-]*"
    },
    "rule_set": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "selectors"
        },
        {
          "type": "SYMBOL",
          "name": "block"
        }
      ]
    },
    "selectors": {
      "type": "REPEAT1",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SYMBOL",
            "name": "_selector_part"
          },
          {
            "type": "STRING",
            "value": ","
          }
        ]
      }
    },
    "_selector_part": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "class_selector"
        },
        {
          "type": "SYMBOL",
          "name": "id_selector"
        },
        {
          "type": "SYMBOL",
          "name": "pseudo_selector"
        },
        {
          "type": "SYMBOL",
          "name": "attribute_selector"
        },
        {
          "type": "SYMBOL",
          "name": "nesting_selector"
        },
        {
          "type": "SYMBOL",
          "name": "universal_selector"
        },
        {
          "type": "SYMBOL",
          "name": "combinator"
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "SYMBOL",
            "name": "identifier"
          },
          "named": true,
          "value": "tag_name"
        },
        {
          "type": "SYMBOL",
          "name": "percentage"
        },
        {
          "type": "SYMBOL",
          "name": "string"
        }
      ]
    },
    "class_selector": {
      "type": "PATTERN",
      "value": "\\.-?([a-zA-Z_]|\\\\.)([\\w-]|\\\\.)*"
    },
    "id_selector": {
      "type": "PATTERN",
      "value": "#-?([a-zA-Z_]|\\\\.)([\\w-]|\\\\.)*"
    },
    "pseudo_selector": {
      "type": "SEQ",
      "members": [
        {
          "type": "PATTERN",
          "value": "::?[a-zA-Z-][\\w-]*"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "IMMEDIATE_TOKEN",
                  "content": {
                    "type": "STRING",
                    "value": "("
                  }
                },
                {
                  "type": "REPEAT",
                  "content": {
                    "type": "CHOICE",
                    "members": [
                      {
                        "type": "SYMBOL",
                        "name": "_selector_part"
                      },
                      {
                        "type": "STRING",
                        "value": ","
                      },
                      {
                        "type": "SYMBOL",
                        "name": "number"
                      }
                    ]
                  }
                },
                {
                  "type": "STRING",
                  "value": ")"
                }
              ]
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "attribute_selector": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "["
        },
        {
          "type": "PATTERN",
          "value": "[a-zA-Z_-][\\w-]*"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "PATTERN",
                  "value": "[~|^$*]?="
                },
                {
                  "type": "CHOICE",
                  "members": [
                    {
                      "type": "SYMBOL",
                      "name": "string"
                    },
                    {
                      "type": "SYMBOL",
                      "name": "identifier"
                    }
                  ]
                }
              ]
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "PATTERN",
              "value": "[is]"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "STRING",
          "value": "]"
        }
      ]
    },
    "nesting_selector": {
      "type": "STRING",
      "value": "&"
    },
    "universal_selector": {
      "type": "STRING",
      "value": "*"
    },
    "combinator": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": ">"
        },
        {
          "type": "STRING",
          "value": "+"
        },
        {
          "type": "STRING",
          "value": "~"
        }
      ]
    },
    "block": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "{"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_statement"
          }
        },
        {
          "type": "STRING",
          "value": "}"
        }
      ]
    },
    "declaration": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "property",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "property_name"
              },
              {
                "type": "SYMBOL",
                "name": "custom_property_name"
              }
            ]
          }
        },
        {
          "type": "STRING",
          "value": ":"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "value"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "_terminator"
        }
      ]
    },
    "property_name": {
      "type": "ALIAS",
      "content": {
        "type": "SYMBOL",
        "name": "identifier"
      },
      "named": false,
      "value": "property_name"
    },
    "custom_property_name": {
      "type": "PATTERN",
      "value": "--[\\w-]*"
    },
    "value": {
      "type": "SYMBOL",
      "name": "_values"
    },
    "_values": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_value"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "_value"
              },
              {
                "type": "SEQ",
                "members": [
                  {
                    "type": "STRING",
                    "value": ","
                  },
                  {
                    "type": "SYMBOL",
                    "name": "_value"
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    "_value": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "identifier"
        },
        {
          "type": "SYMBOL",
          "name": "number"
        },
        {
          "type": "SYMBOL",
          "name": "percentage"
        },
        {
          "type": "SYMBOL",
          "name": "color"
        },
        {
          "type": "SYMBOL",
          "name": "string"
        },
        {
          "type": "SYMBOL",
          "name": "url"
        },
        {
          "type": "SYMBOL",
          "name": "call_expression"
        },
        {
          "type": "SYMBOL",
          "name": "important"
        },
        {
          "type": "SYMBOL",
          "name": "custom_property_name"
        },
        {
          "type": "SYMBOL",
          "name": "placeholder_name"
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "SYMBOL",
            "name": "at_keyword"
          },
          "named": true,
          "value": "property_lookup"
        },
        {
          "type": "SYMBOL",
          "name": "parenthesized_value"
        },
        {
          "type": "STRING",
          "value": "/"
        },
        {
          "type": "STRING",
          "value": "*"
        },
        {
          "type": "STRING",
          "value": "+"
        },
        {
          "type": "STRING",
          "value": "-"
        },
        {
          "type": "STRING",
          "value": "="
        }
      ]
    },
    "identifier": {
      "type": "PATTERN",
      "value": "-?([a-zA-Z_]|\\\\.)([\\w-]|\\\\.)*"
    },
    "number": {
      "type": "PATTERN",
      "value": "[-+]?(\\d+\\.?\\d*|\\.\\d+)([eE][-+]?\\d+)?[a-zA-Z]*"
    },
    "percentage": {
      "type": "PATTERN",
      "value": "[-+]?(\\d+\\.?\\d*|\\.\\d+)%"
    },
    "color": {
      "type": "PATTERN",
      "value": "#[0-9a-fA-F]{3,8}"
    },
    "string": {
      "type": "TOKEN",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": "'"
              },
              {
                "type": "PATTERN",
                "value": "([^'\\\\\\n]|\\\\.)*"
              },
              {
                "type": "STRING",
                "value": "'"
              }
            ]
          },
          {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": "\""
              },
              {
                "type": "PATTERN",
                "value": "([^\"\\\\\\n]|\\\\.)*"
              },
              {
                "type": "STRING",
                "value": "\""
              }
            ]
          }
        ]
      }
    },
    "url": {
      "type": "PATTERN",
      "value": "url\\([^)\"']*\\)"
    },
    "important": {
      "type": "PATTERN",
      "value": "!\\s*important"
    },
    "call_expression": {
      "type": "SEQ",
      "members": [
        {
          "type": "ALIAS",
          "content": {
            "type": "SYMBOL",
            "name": "identifier"
          },
          "named": true,
          "value": "function_name"
        },
        {
          "type": "IMMEDIATE_TOKEN",
          "content": {
            "type": "STRING",
            "value": "("
          }
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "_value"
              },
              {
                "type": "STRING",
                "value": ":"
              },
              {
                "type": "STRING",
                "value": ","
              }
            ]
          }
        },
        {
          "type": "STRING",
          "value": ")"
        }
      ]
    },
    "parenthesized_value": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "_value"
              },
              {
                "type": "STRING",
                "value": ":"
              },
              {
                "type": "STRING",
                "value": ","
              },
              {
                "type": "PATTERN",
                "value": "[<>]=?"
              }
            ]
          }
        },
        {
          "type": "STRING",
          "value": ")"
        }
      ]
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s"
    },
    {
      "type": "SYMBOL",
      "name": "comment"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [
    {
      "type": "SYMBOL",
      "name": "_terminator"
    }
  ],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}