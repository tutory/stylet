// highlight.js token colors (see theme.styl).
.hljs-comment {
  color: var(--hl-comment)
  font-style: italic
}

.hljs-keyword,
.hljs-meta {
  color: var(--hl-keyword)
}

.hljs-selector-tag,
.hljs-selector-class,
.hljs-selector-id,
.hljs-selector-pseudo,
.hljs-selector-attr {
  color: var(--hl-selector)
}

.hljs-attribute,
.hljs-attr {
  color: var(--hl-attribute)
}

.hljs-string {
  color: var(--hl-string)
}

.hljs-number {
  color: var(--hl-number)
}

.hljs-variable {
  color: var(--hl-variable)
}

.hljs-built_in {
  color: var(--hl-function)
}
