@import 'theme'
@import 'highlight'

body {
  background: var(--bg)
  color: var(--text)
  font: 16px/1.6 system-ui, -apple-system, 'Segoe UI', sans-serif
  margin: 0
}

a {
  color: var(--accent)
}

code {
  font-family: var(--mono)
  font-size: .9em
}

.top,
main,
footer {
  margin: 0 auto
  max-width: 64rem
  padding: 0 1rem
}

.top {
  display: flex
  flex-wrap: wrap
  gap: .5rem 1.5rem
  padding-block: 1.25rem
  align-items: center

  .brand {
    color: var(--text)
    font-size: 1.2rem
    font-weight: 700
    margin-right: auto
    text-decoration: none
  }

  nav {
    display: flex
    gap: 1.25rem
  }

  nav a {
    color: var(--muted)
    text-decoration: none

    &:hover {
      color: var(--text)
    }
  }
}

.hero {
  padding-block: 3rem 2rem

  h1 {
    font-size: clamp(2rem, 5vw, 3.2rem)
    line-height: 1.1
    letter-spacing: -.02em
    margin: 0 0 1rem
    text-wrap: balance
  }

  .lead {
    color: var(--muted)
    font-size: 1.15rem
    margin: 0
    max-width: 40rem
  }
}

.actions {
  display: flex
  flex-wrap: wrap
  gap: .75rem
  margin-top: 1.75rem
}

.button {
  border: 1px solid var(--border)
  border-radius: 8px
  color: var(--text)
  font-weight: 500
  padding: .6rem 1.1rem
  text-decoration: none

  &:hover {
    border-color: var(--accent)
  }

  &.primary {
    background: var(--accent)
    border-color: var(--accent)
    color: var(--accent-text)
  }
}

.example {
  display: grid
  gap: 1rem
  grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr))
  padding-block: 1rem 2.5rem
}

figure {
  margin: 0
  min-width: 0
}

figcaption {
  color: var(--muted)
  display: flex
  font: 12px var(--mono)
  gap: .5rem
  margin-bottom: .4rem
  justify-content: space-between

  .hint {
    color: var(--muted)
    opacity: .8
  }

  a.hint:hover {
    color: var(--accent)
    opacity: 1
  }
}

// The editable example: a transparent textarea over its highlighted copy,
// stacked in one grid cell so the box grows with the code.
.editor {
  @extend $panel
  border-radius: 10px
  display: grid

  pre,
  textarea {
    background: transparent
    border: 0
    border-radius: 0
    font: 13.5px/1.55 var(--mono)
    grid-area: 1 / 1
    margin: 0
    overflow: hidden
    padding: 1rem 1.25rem
    tab-size: 2
    white-space: pre
  }

  textarea {
    caret-color: var(--text)
    color: transparent
    outline: none
    resize: none
  }

  &:focus-within {
    border-color: var(--accent)
  }
}

#example-diagnostics {
  color: var(--error)
  font: 12px/1.5 var(--mono)
  list-style: none
  margin: .5rem 0 0
  padding: 0
}

pre {
  @extend $panel
  border-radius: 10px
  font: 13.5px/1.55 var(--mono)
  margin: 0
  overflow: auto
  padding: 1rem 1.25rem

  code {
    font-size: inherit
  }
}

.features {
  display: grid
  gap: 1.5rem 2rem
  grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr))
  padding-block: 1.5rem 3rem

  h2 {
    font-size: 1.05rem
    margin: 0 0 .35rem
  }

  p {
    color: var(--muted)
    margin: 0
  }
}

.start {
  padding-bottom: 3rem

  h2 {
    font-size: 1.4rem
    margin: 0 0 1rem
  }

  p {
    color: var(--muted)
  }
}

footer {
  border-top: 1px solid var(--border)
  color: var(--muted)
  font-size: .9rem
  padding-block: 1.5rem 2.5rem
}
