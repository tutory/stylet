=== /p/components/button.styl
.button,
.link {
  box-shadow: var(--shadow)
  color: color-mix(in srgb, var(--black) 80%, transparent)
  display: flex
  font: 12px/1.5 sans-serif
  gap: calc(var(--gap) * 2)
  margin: var(--alias)
  align-items: center
  justify-content: space-between
  text-overflow: ellipsis
  white-space: nowrap
  width: calc(100% - 10px)
  @extend $focus

  &:hover {
    color: red // hover
  }

  @media (max-width: 600px) {
    padding: 0
  }

  // stylet-migrate: for n in 1..2
  // stylet-migrate:   .l-{n}
  // stylet-migrate:     x: n
  // stylet-migrate: if isDevelopment
  // stylet-migrate:   outline: red
  // stylet-migrate: @extend .other
}
=== /p/index.styl
@import 'vars'
@import 'mixins'
@import 'components/button' layer(base)
=== /p/mixins.styl
