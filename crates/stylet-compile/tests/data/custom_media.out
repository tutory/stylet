@media (width <= 600px) {
  .a {
    color: red;
  }
}

@media screen and ((width <= 600px) and (orientation: landscape)) {
  .b {
    color: red;
  }
}

@media not (orientation: landscape) {
  .c {
    color: red;
  }
}

@media print {
  .d {
    color: red;
  }
}

@media screen and (--print) {
  .e {
    color: red;
  }
}

@media (--unknown) {
  .f {
    color: red;
  }
}

@media (--loop) {
  .g {
    color: red;
  }
}
