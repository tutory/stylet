.early, .button, .link, :is(.button, .link) .icon, :is(.button, .link).small, .card, .toolbar .item {
  padding: 4px;
  &:hover {
    color: blue;
  }
}

.button, .link, :is(.button, .link) .icon {
  color: white;
}

.button, .link {
  color: red;
}
