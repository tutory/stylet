=== env/a/index.styl
@layer base {
  html {
    margin: 0;
  }
}

.button {
  background: url(../client/img/bg.png) no-repeat;
  mask: url("data:image/svg+xml;base64,PHN2Zy8+");
  cursor: url('https://x.y/c.cur'), auto;
}

.dashboard {
  color: red;
  &:hover {
    color: blue;
  }
}

.other {
  color: red;
  &:hover {
    color: blue;
  }
}

.legacy { color: green; }
